---
import BaseLayout from '../../layouts/BaseLayout.astro';import FortuneApp from '../../components/FortuneApp.astro';import SignCard from '../../components/SignCard.astro';import signs from '../../data/signs.json';
export function getStaticPaths(){const paths=signs.filter(x=>x.type==='horoscope');return paths.map(sign=>({params:{slug:sign.slug},props:{sign}}))}const items=signs.filter(x=>x.type==='horoscope');const{sign}=Astro.props;const index=items.findIndex(x=>x.slug===sign.slug);const related=[items[(index+1)%12],items[(index+11)%12],items[(index+6)%12]];
const faqs=[{q:`${sign.name} 생일 구간은 언제인가요?`,a:`일반적으로 ${sign.period} 구간을 사용합니다. 경계 날짜는 연도와 계산 방식에 따라 달라질 수 있습니다.`},{q:`${sign.name} 오늘 운세는 과학적 성격 진단인가요?`,a:'아닙니다. 별자리 상징을 활용한 오락·자기성찰 콘텐츠이며 성격이나 미래를 과학적으로 진단하지 않습니다.'}];
const jsonLd=[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'홈',item:new URL('/',Astro.site).href},{'@type':'ListItem',position:2,name:'별자리 운세',item:new URL('/horoscope/',Astro.site).href},{'@type':'ListItem',position:3,name:`${sign.name} 오늘 운세`,item:Astro.url.href}]},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))}];
---
<BaseLayout title={`${sign.name} 오늘 운세와 성향: ${sign.period} | 오늘운`} description={`${sign.period} ${sign.name}의 오늘 운세와 대표 성향을 확인하세요. 관계, 일·공부, 재물, 컨디션, 행운 색상과 오늘의 행동을 제공합니다.`} jsonLd={jsonLd}>
<div class="shell" style="padding-top:1.4rem"><nav class="breadcrumb"><a href="/">홈</a><span>›</span><a href="/horoscope/">별자리 운세</a><span>›</span><span>{sign.name}</span></nav><section class="profile-hero"><div class="profile-symbol" aria-hidden="true">{sign.emoji}</div><div><span class="eyebrow">{sign.period}</span><h1>{sign.name} 오늘 운세</h1><p>{sign.summary}</p><div class="keyword-chips">{sign.keywords.map(x=><span>{x}</span>)}</div></div></section><div class="profile-grid"><section class="profile-card"><span>강점</span><p>{sign.strength}</p></section><section class="profile-card"><span>균형을 위한 관점</span><p>{sign.caution}</p></section></div><FortuneApp fixedType="horoscope" fixedSlug={sign.slug} title={`${sign.name} 오늘의 흐름`} description="한국 시간 기준 날짜가 바뀌면 새로운 결과가 자동으로 표시됩니다." /></div>
<section class="section"><div class="shell"><div class="section-head"><div><h2>{sign.name} 성향을 생활에 적용하기</h2><p>별자리 설명은 고정된 성격 판정이 아니라 현재의 선택을 돌아보기 위한 관점입니다.</p></div></div><div class="grid grid-2"><article class="card"><h3>관계</h3><p>{sign.relationship}</p></article><article class="card"><h3>일과 공부</h3><p>{sign.work}</p></article><article class="card"><h3>재물 습관</h3><p>{sign.money}</p></article><article class="card"><h3>컨디션</h3><p>{sign.condition}</p></article></div></div></section>
<section class="section soft"><div class="shell"><div class="section-head"><div><h2>함께 볼 별자리</h2></div></div><div class="grid grid-3">{related.map(item=><SignCard sign={item}/>)}</div><div style="margin-top:1.2rem">{faqs.map(x=><details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></div></section>
</BaseLayout>
