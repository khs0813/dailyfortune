---
import BaseLayout from '../layouts/BaseLayout.astro';import FortuneApp from '../components/FortuneApp.astro';
---
<BaseLayout title="오늘의 운세: 띠와 별자리 개인 프로필 | 오늘운" description="저장한 띠 또는 별자리 프로필로 오늘 운세를 바로 확인하고 최근 7일 결과, 연속 방문, 행운 색상과 오늘의 행동을 확인하세요." adFitPage={true}>
<header class="page-head"><div class="shell"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><span>오늘 운세</span></nav><span class="eyebrow">매일 자정 갱신</span><h1>오늘의 운세</h1><p>프로필을 저장하면 다음 방문부터 바로 불러옵니다. 기록과 설정은 서버가 아니라 현재 브라우저에만 저장됩니다.</p></div></header><section class="shell" style="padding-bottom:4rem"><FortuneApp title="오늘의 개인 운세" description="최근 7일 버튼을 눌러 지나간 결과도 다시 확인할 수 있습니다." adPlacement="today.afterSummary" nextLinks="today" /></section>
</BaseLayout>
