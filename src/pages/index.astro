---
import BaseLayout from '../layouts/BaseLayout.astro';import FortuneApp from '../components/FortuneApp.astro';import SignCard from '../components/SignCard.astro';import signs from '../data/signs.json';
const zodiac=signs.filter(x=>x.type==='zodiac').slice(0,6),horoscope=signs.filter(x=>x.type==='horoscope').slice(0,6);
const jsonLd={'@context':'https://schema.org','@type':'ItemList',name:'오늘의 띠와 별자리 운세',itemListElement:[...zodiac,...horoscope].map((x,i)=>({'@type':'ListItem',position:i+1,name:`${x.name} 오늘 운세`,url:new URL(x.type==='zodiac'?`/zodiac/${x.slug}/`:`/horoscope/${x.slug}/`,Astro.site).href}))};
---
<BaseLayout title="오늘의 띠별 운세와 별자리 운세 무료 보기 | 오늘운" description="한국 시간 기준으로 매일 바뀌는 12띠와 12별자리 운세를 확인하세요. 관계, 일·공부, 재물, 컨디션과 오늘의 행동을 회원가입 없이 제공합니다." jsonLd={jsonLd}>
<section class="hero"><div class="shell hero-grid"><div class="hero-copy"><span class="eyebrow">한국 시간 기준 매일 갱신</span><h1>오늘의 흐름을 <em>가볍게 확인하세요</em></h1><p>띠나 별자리를 선택하면 관계, 일·공부, 재물, 컨디션과 오늘 해볼 일을 바로 보여 줍니다. 결과는 같은 날짜와 같은 프로필에 항상 동일합니다.</p><ul class="hero-points"><li>회원가입 없음</li><li>띠 12개 · 별자리 12개</li><li>최근 7일 다시 보기</li><li>연속 방문 기록</li></ul><div class="button-row" style="margin-top:1.1rem"><a class="button primary" href="#today-fortune">오늘 운세 보기</a><a class="button secondary" href="/guide/how-results-work/">결과 생성 방식</a></div></div><div class="hero-art" aria-hidden="true"><div class="sun-disc">運</div><div class="orbit"><span>🐲</span><span>♌</span><span>🐰</span></div></div></div></section>
<section class="section" id="today-fortune"><div class="shell"><FortuneApp title="내 오늘 운세" description="띠 또는 별자리를 선택하고 프로필을 저장하면 다음 방문부터 바로 같은 유형이 열립니다." /></div></section>
<section class="section soft"><div class="shell"><div class="section-head"><div><span class="eyebrow">동양의 12지 상징</span><h2>띠별 오늘 운세</h2><p>자신의 띠를 직접 선택해 매일의 흐름을 확인하세요. 음력 설 전후 출생자는 띠 계산 방식이 다를 수 있어 직접 선택을 권장합니다.</p></div><a class="text-link" href="/zodiac/">12띠 전체 보기 →</a></div><div class="grid grid-3">{zodiac.map(sign=><SignCard sign={sign}/>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">서양 점성술의 12구간</span><h2>별자리 오늘 운세</h2><p>생일 구간으로 별자리를 찾고, 별자리의 성향 설명과 오늘의 결과를 함께 확인하세요.</p></div><a class="text-link" href="/horoscope/">12별자리 전체 보기 →</a></div><div class="grid grid-3">{horoscope.map(sign=><SignCard sign={sign}/>)}</div></div></section>
<section class="section soft"><div class="shell grid grid-3"><a class="card card-link" href="/weekly/"><h3>이번 주 운세</h3><p>일주일 동안 집중할 키워드와 관계·일·재물·컨디션의 흐름을 확인합니다.</p></a><a class="card card-link" href="/monthly/"><h3>이번 달 운세</h3><p>한 달의 방향을 큰 흐름으로 보고 실천할 행동과 조심할 패턴을 정합니다.</p></a><a class="card card-link" href="/guide/zodiac-horoscope/"><h3>띠와 별자리 차이</h3><p>두 체계가 무엇을 기준으로 나뉘며 이 사이트에서 어떻게 사용하는지 설명합니다.</p></a></div></section>
</BaseLayout>
