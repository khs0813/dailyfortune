---
interface Props {
  label?: string;
  score?: number;
  max?: number;
  caption?: string;
}

const {
  label = '종합 흐름',
  score = 0,
  max = 5,
  caption = '관계, 일, 재물, 컨디션 평균'
} = Astro.props;
const boundedScore = Math.min(Math.max(score, 0), max);
const progress = max > 0 ? (boundedScore / max) * 100 : 0;
---
<div
  class="score-progress"
  data-score-progress
  data-result-score-meter
  data-score-max={max}
  role="meter"
  aria-label={`${label} 점수`}
  aria-valuemin="0"
  aria-valuemax={max}
  aria-valuenow={boundedScore}
  aria-valuetext={`${boundedScore}점 / ${max}점`}
  style={`--score-progress:${progress}%`}
>
  <div class="score-progress__head">
    <span class="score-progress__label">{label}</span>
    <span class="score-progress__value">
      <strong data-score-current data-result-score>{boundedScore}</strong>
      <span aria-hidden="true">/ {max}</span>
    </span>
  </div>
  <span class="score-progress__track" aria-hidden="true">
    <span class="score-progress__fill"></span>
  </span>
  {caption && <p class="score-progress__caption">{caption}</p>}
</div>

<style>
  .score-progress {
    min-width: 0;
    width: 100%;
    display: grid;
    gap: .5rem;
    align-self: center;
    padding: .82rem .9rem;
    border: 1px solid #f0d6ce;
    border-radius: 16px;
    background: rgba(255, 255, 255, .88);
    box-shadow: 0 9px 24px rgba(112, 48, 45, .07);
  }

  .score-progress__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .75rem;
  }

  .score-progress__label {
    color: var(--muted);
    font-size: .74rem;
    font-weight: 950;
    white-space: nowrap;
  }

  .score-progress__value {
    display: inline-flex;
    align-items: baseline;
    gap: .08rem;
    color: var(--brand-deep);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .score-progress__value strong {
    font-size: 1.45rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .score-progress__value span {
    color: var(--muted);
    font-size: .74rem;
  }

  .score-progress__track {
    position: relative;
    overflow: hidden;
    height: 9px;
    border-radius: 999px;
    background: #f8ddd6;
    box-shadow: inset 0 0 0 1px rgba(142, 47, 53, .07);
  }

  .score-progress__fill {
    display: block;
    width: var(--score-progress);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gold), var(--brand));
    transition: width .24s ease;
  }

  .score-progress__caption {
    margin: 0;
    color: #806e6f;
    font-size: .72rem;
    line-height: 1.35;
  }

  @media (max-width: 700px) {
    .score-progress {
      grid-column: 1 / -1;
      padding: .72rem .78rem;
      border-radius: 15px;
      gap: .44rem;
    }

    .score-progress__value strong {
      font-size: 1.25rem;
    }

    .score-progress__caption {
      font-size: .7rem;
    }
  }

  @media (max-width: 390px) {
    .score-progress__head {
      gap: .55rem;
    }

    .score-progress__label {
      font-size: .7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .score-progress__fill {
      transition: none;
    }
  }
</style>
